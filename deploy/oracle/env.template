# /var/www/99visual/.env — settings for www.99visual.com on the Oracle server.
# Created by setup-server.sh. Fill in the empty values (copy them from Vercel → Project → Settings →
# Environment Variables), then run deploy.sh. Never commit this file. After changing it, run deploy.sh
# again (NEXT_PUBLIC_* values are built into the pages).

# This is the live site: Google Analytics and IndexNow only run when this says production.
APP_ENV=production

# Database: PostgreSQL on this same server (filled in for you).
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@127.0.0.1:5432/${DB_NAME}

# Admin sign-in tokens (generated for you; changing it signs admins out).
JWT_SECRET=${JWT_SECRET}

# Email (Gmail app password used by the contact, careers, chat and newsletter forms)
EMAIL_USER=
EMAIL_PASS=
LEAD_EMAIL=
APPLY_TO_EMAIL=

# Resend (newsletter confirmation emails)
RESEND_API_KEY=
RESEND_FROM=

# Cloudinary (images uploaded in the admin)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Chat assistant
OPENAI_API_KEY=

# Contact-form captcha
CAPTCHA_SECRET=

# Google Analytics 4 (G-XXXXXXX) and Search Console verification
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GSC_VERIFICATION=
